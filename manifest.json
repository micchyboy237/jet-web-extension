{
  "manifest_version": 3,
  "name": "Jet Web Extension",
  "description": "Practice Chrome/Opera extension development",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "clipboardWrite",
    "tabs",
    "webRequest",
    "history",
    "favicon"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "Command+Shift+J"
      },
      "description": "Open Jet Tools popup"
    },
    "deduplicate-now": {
      "suggested_key": {
        "default": "Ctrl+Shift+D"
      },
      "description": "Deduplicate tabs now"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "tabs.html",
        "tabs.js",
        "network.html",
        "network.js",
        "history.html",
        "history.js",
        "summarization.html",
        "summarization.js",
        "links-tree.html",
        "links-tree.js",
        "vendor/js-beautify/beautify-html.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
